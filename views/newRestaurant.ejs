<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Add Restaurant</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

</head>

<body class="bg-light">

    <div class="container py-5">

        <div class="row justify-content-center">

            <div class="col-lg-8">

                <div class="card shadow-lg border-0 rounded-4 p-4">

                    <h1 class="text-center mb-5 fw-bold">
                        🍔 Add New Restaurant
                    </h1>


                    <form action="/partner/restaurants" method="POST" class="needs-validation" novalidate enctype="multipart/form-data">


                        <!-- Restaurant Details -->

                        <h4 class="mb-4 text-warning">
                            Restaurant Details
                        </h4>

                        <div class="mb-3">

                            <label class="form-label">
                                Hotel Name
                            </label>

                            <input
                                type="text"
                                name="name"
                                class="form-control"
                                required
                            >
                            <div class="invalid-feedback">
                                Please enter your valid restaurant name.
                            </div>

                        </div>


                        <div class="mb-3">

                            <label class="form-label">
                                Location
                            </label>

                            <input
                                type="text"
                                name="location"
                                class="form-control"
                                required
                            >
                            <div class="invalid-feedback">
                                Please enter your valid Location.
                            </div>

                        </div>


                        <div class="mb-3">

                            <label class="form-label">
                                Upload Hotel image
                            </label>

                            <input
                                type="file"
                                name="image"
                                class="form-control"
                                required
                            >
                            <div class="invalid-feedback">
                                Please upload your restaurant image.
                            </div>

                        </div>


                        <div class="mb-5">

                            <label class="form-label">
                                Rating
                            </label>

                            <input
                                type="number"
                                step="0.1"
                                name="rating"
                                class="form-control"
                                required
                            >

                        </div>



                        <!-- Dish Details -->

                        <!-- <h4 class="mb-4 text-warning">
                            Dish Details
                        </h4>


                        <div class="mb-3">

                            <label class="form-label">
                                Dish Name
                            </label>

                            <input
                                type="text"
                                name="dishes[0][name]"
                                class="form-control"
                                required
                            >

                        </div>


                        <div class="mb-3">

                            <label class="form-label">
                                Dish Price
                            </label>

                            <input
                                type="number"
                                name="dishes[0][price]"
                                class="form-control"
                                required
                            >

                        </div>


                        <div class="mb-5">

                            <label class="form-label">
                                Dish Image URL
                            </label>

                            <input
                                type="text"
                                name="dishes[0][image]"
                                class="form-control"
                                required
                            >

                        </div> -->



                        <!-- Submit -->

                        <button class="btn btn-dark w-100 py-3">

                            Add Restaurant

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

    <script src="/js/script.js"></script>
</body>

</html>