<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Add Food</title>

    <!-- Bootstrap -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

</head>

<body class="bg-light">

    <div class="container py-5">

        <div class="row justify-content-center">

            <div class="col-lg-6">

                <div class="card shadow-lg border-0 rounded-4 p-4">

                    <h1 class="text-center fw-bold mb-5">
                        🍔 Add New Food
                    </h1>


                    <form action="/dishes" method="POST" class="needs-validation" novalidate>


                        <!-- Food Name -->

                        <div class="mb-4">

                            <label class="form-label">
                                Food Name
                            </label>

                            <input
                                type="text"
                                name="name"
                                class="form-control"
                                required
                            >
                            <div class="invalid-feedback">
                                Please Enter the name of dish.
                            </div>
                            <div class="valid-feedback">
                               Looks Good.
                            </div>
                        </div>



                        <!-- Food Image -->

                        <div class="mb-5">

                            <label class="form-label">
                                Food Image URL
                            </label>

                            <input
                                type="url"
                                name="image"
                                class="form-control"
                                required
                            >
                            <div class="invalid-feedback">
                                Please Upload image.
                            </div>

                        </div>



                        <!-- Submit Button -->

                        <button class="btn btn-dark w-100 py-3">

                            Add Food

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

    <script src="/js/script.js"></script>

</body>

</html>