<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>BhookhBite</title>

  <!-- Bootstrap CSS -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/style.css">

  <!-- FONT AWESOME........... -->
  <link
     rel="stylesheet"
     href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
  />

</head>

<body class="bg-light">

  <!-- Navbar -->
  <%- include("partials/nav") %>



  <div class="container py-5">

    <!-- Heading -->
    <h1 class="text-center fw-bold mb-5">
      <i class="fa-solid fa-burger text-warning me-2"></i>
      BhookhBite
    </h1>



    <!-- Cards -->
    <div class="row g-4">

      <% for(let dish of dishes) { %>

        <div class="col-lg-3 col-md-4 col-sm-6">

          <div class="card food-card shadow border-0 rounded-4 h-100 overflow-hidden">


            <!-- CLICKABLE IMAGE -->
            <a
              href="/dishes/<%= dish.name %>"
              class="text-decoration-none"
            >

              <img
                src="<%= dish.image %>"
                class="card-img-top food-image"
                alt="<%= dish.name %>"
                style="height: 220px; object-fit: cover;"
              >

            </a>



            <!-- Card Body -->
            <div class="card-body d-flex flex-column">


              <!-- CLICKABLE NAME -->
              <a
                href="/dishes/<%= dish.name %>"
                class="text-decoration-none text-dark"
              >

                <h5 class="card-title fw-bold text-center mb-4">

                  <%= dish.name %>

                </h5>

              </a>

            </div>

          </div>

        </div>

      <% } %>

    </div>

  </div>



  <!-- Footer -->
  <%- include("partials/footer") %>



  <!-- Bootstrap JS -->
  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
  ></script>

</body>

</html>  