<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>

        Partner Dashboard

    </title>

    <!-- Bootstrap -->

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <!-- Google Font -->

    <link
        rel="preconnect"
        href="https://fonts.googleapis.com"
    >

    <link
        rel="preconnect"
        href="https://fonts.gstatic.com"
        crossorigin
    >

    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet"
    >

    <!-- CUSTOM CSS -->

    <link
        rel="stylesheet"
        href="/css/partnerDashboard.css"
    >


    <!-- FONT AWESOME........... -->
  <link
     rel="stylesheet"
     href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
  />

</head>

<body>

        <%- include("../partials/flash") %>


    <div class="container py-5">

        <!-- STATS -->

<div class="dashboard-stats">





    <!-- TOTAL RESTAURANTS -->

    <div class="stats-card">

        <h2>

            <%= hotels.length %>

        </h2>

        <p>

            Restaurants

        </p>

    </div>





    <!-- TOTAL ORDERS -->

    <div class="stats-card">

        <h2>

            <%= totalOrders %>

        </h2>

        <p>

            Orders

        </p>

    </div>





    <!-- EARNINGS -->

    <div class="stats-card">

        <h2>

            ₹ <%= totalEarnings %>

        </h2>

        <p>

            Earnings

        </p>

    </div>





    <!-- DISHES SOLD -->

    <div class="stats-card">

        <h2>

            <%= totalDishesSold %>

        </h2>

        <p>

            Dishes Sold

        </p>

    </div>

</div>

        <!-- HEADER -->

        <div class="dashboard-header mb-5">

            <div
                class="d-flex
                justify-content-between
                align-items-center
                flex-wrap
                gap-4"
            >

                <div>

                    <h1>

                        Partner Dashboard

                    </h1>

                    <p>

                        Manage your restaurants,
                        dishes, pricing and more.

                    </p>

                </div>

                <div>

                    <a
                        href="/partner/restaurants/new"
                        class="add-btn"
                    >

                        + Add Restaurant

                    </a>

                </div>

            </div>

        </div>


        <!-- TITLE -->

        <div class="mb-4">

            <h2 class="section-title">

                Your Restaurants

            </h2>

        </div>


        <!-- EMPTY STATE -->

        <% if(hotels.length === 0){ %>

            <div class="empty-box">

                <h3>

                    No Restaurants Added Yet

                </h3>

                <p>

                    Start by creating your first
                    restaurant and grow your business.

                </p>

            </div>

        <% } %>


        <!-- RESTAURANT CARDS -->

        <div class="row g-4">

            <% for(let hotel of hotels){ %>

                <div class="col-lg-4 col-md-6">

                    <div class="restaurant-card">

                        <img
                            src="<%= hotel.image.url %>"
                            class="restaurant-img"
                        >

                        <div class="restaurant-content">

                            <div class="restaurant-title">

                                <%= hotel.name %>

                            </div>

                            <div class="restaurant-location d-flex align-items-center">

                              <i class="fa-solid fa-location-dot text-danger me-2"></i>
                              <span><%= hotel.location %></span>

                            </div>

                            <div class="rating d-flex align-items-center">

                              <i class="fa-solid fa-star text-warning me-2"></i>
                              <span><%= hotel.rating %></span>

                            </div>

                            <a
                               href="/partner/restaurants/<%= hotel._id %>"
                               class="manage-btn"
                            >
                               <i class="fa-solid fa-gear me-2"></i>
                               Manage Restaurant
                            </a>

                        </div>

                    </div>

                </div>

            <% } %>

        </div>

    </div>

</body>

</html>