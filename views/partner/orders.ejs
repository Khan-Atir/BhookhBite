<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>

        Partner Orders

    </title>

    <!-- Bootstrap -->

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <!-- Custom CSS -->

    <link
        rel="stylesheet"
        href="/css/partnerOrders.css"
    >

</head>

<body>

    <%- include("../partials/nav.ejs") %>





    <div class="container py-5">





        <!-- PAGE HEADING -->

        <div class="orders-heading">

            <h1>

                Incoming Orders

            </h1>

            <div class="heading-line"></div>

        </div>





        <!-- EMPTY STATE -->

        <% if(orders.length === 0){ %>

            <div class="empty-orders">

                <h2>

                    No Orders Yet

                </h2>

                <p>

                    Orders from customers will appear here.

                </p>

            </div>

        <% } %>





        <!-- ORDERS -->

        <% orders.forEach((order)=>{ %>





        <div class="order-card">

            <div class="order-card-body">





                <!-- ORDER HEADER -->

                <div class="order-header">

                    <div>

                        <h3>

                            Order #<%= order._id.toString().slice(-6) %>

                        </h3>

                        <p class="order-date">

                            <%= order.createdAt.toDateString() %>

                        </p>

                    </div>





                    <span

                        class="
                        status-badge
                        <%= order.orderStatus === 'Delivered'
                            ? 'status-delivered'
                            : order.orderStatus === 'Preparing'
                            ? 'status-preparing'
                            : order.orderStatus === 'Out For Delivery'
                            ? 'status-out'
                            : 'status-pending'
                        %>
                        "

                    >

                        <%= order.orderStatus %>

                    </span>

                </div>





                <!-- CUSTOMER DETAILS -->

                <div class="customer-box">

                    <p>

                        📞 <%= order.phone %>

                    </p>

                    <p>

                        📍 <%= order.deliveryAddress %>

                    </p>

                </div>


                <div class="mt-2">
                    <strong>Payment:</strong>
                    <%= order.paymentMethod %>
                </div>

                <div class="mt-1">
                    <strong>Status:</strong>

                    <span class="
                        badge
                        <%= order.paymentStatus === 'Paid'
                        ? 'bg-success'
                        : 'bg-warning text-dark' %>
                    ">
                        <%= order.paymentStatus %>
                    </span>
                </div>





                <!-- ITEMS -->

                <div class="items-wrapper">

                    <% order.items.forEach((item)=>{ %>

                    <div class="item-row">

                        <div>

                            <strong>

                                <%= item.name %>

                            </strong>

                            <span class="qty">

                                x <%= item.quantity %>

                            </span>

                        </div>





                        <div class="item-price">

                            ₹ <%= item.price * item.quantity %>

                        </div>

                    </div>

                    <% }) %>

                </div>





                <!-- TOTAL -->

                <div class="order-total">

                    Total: ₹ <%= order.totalAmount %>

                </div>





                <!-- STATUS UPDATE -->

                <form

                    action="/partner/orders/<%= order._id %>/status?_method=PUT"

                    method="POST"

                    class="status-form"

                >

                    <select

                        name="status"

                        class="form-select"

                    >

                        <option

                            value="Pending"

                            <%= order.orderStatus === "Pending" ? "selected" : "" %>

                        >

                            Pending

                        </option>





                        <option

                            value="Preparing"

                            <%= order.orderStatus === "Preparing" ? "selected" : "" %>

                        >

                            Preparing

                        </option>



                        <option
                            value="Out For Delivery"
                            <%= order.orderStatus === "Out For Delivery" ? "selected" : "" %>
                        >
                            Out For Delivery
                        </option>





                        <option

                            value="Delivered"

                            <%= order.orderStatus === "Delivered" ? "selected" : "" %>

                        >

                            Delivered

                        </option>

                    </select>





                    <button

                        type="submit"

                        class="update-btn"

                    >

                        Update Status

                    </button>

                </form>

            </div>

        </div>





        <% }) %>

    </div>

</body>

</html>