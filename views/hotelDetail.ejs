<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>

        <%= hotel.name %> | BhookhBite

    </title>





    <!-- BOOTSTRAP -->

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >





    <!-- GOOGLE FONT -->

    <link
        rel="preconnect"
        href="https://fonts.googleapis.com"
    >

    <link
        rel="preconnect"
        href="https://fonts.gstatic.com"
        crossorigin
    >

    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet"
    >





    <!-- CUSTOM CSS -->

    <link
        rel="stylesheet"
        href="/css/hotelDetail.css"
    >

    <link rel="stylesheet" href="/css/style.css">

</head>

<body>





<!-- NAVBAR -->

<%- include("partials/nav") %>





<!-- MAIN -->

<div class="container py-5">





    <!-- HERO SECTION -->

    <div class="restaurant-hero">

        <div class="row g-0 align-items-center">





            <!-- IMAGE -->

            <div class="col-lg-5">

                <div class="hero-image-wrapper">

                    <img
                        src="<%= hotel.image.url %>"
                        alt="<%= hotel.name %>"
                        class="hero-image"
                    >

                </div>

            </div>





            <!-- CONTENT -->

            <div class="col-lg-7">

                <div class="hero-content">





                    <!-- TAG -->

                    <div class="restaurant-tag">

                        Premium Restaurant

                    </div>





                    <!-- NAME -->

                    <h1 class="restaurant-title">

                        <%= hotel.name %>

                    </h1>





                    <!-- LOCATION -->

                    <div class="restaurant-location">

                        📍 <%= hotel.location %>

                    </div>





                    <!-- RATING -->

                    <div class="rating-box">

                        ⭐ <%= hotel.rating %>

                    </div>





                    <!-- DESCRIPTION -->

                    <p class="restaurant-description">

                        Discover delicious dishes prepared with premium
                        ingredients and fast delivery service from
                        <strong><%= hotel.name %></strong>.

                    </p>





                    <!-- STATS -->

                    <div class="hero-stats">

                        <div class="stat-card">

                            <h3>

                                <%= hotel.dishes.length %>

                            </h3>

                            <p>Total Dishes</p>

                        </div>





                        <div class="stat-card">

                            <h3>Open</h3>

                            <p>Status</p>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>





    <!-- SECTION HEADER -->

    <div class="section-header">

        <div>

            <h2 class="section-title">

                Available Dishes

            </h2>

            <p class="section-subtitle">

                Freshly prepared dishes available right now.

            </p>

        </div>





        <div class="dish-count">

            <%= hotel.dishes.length %> Items

        </div>

    </div>





    <!-- DISHES -->

    <div class="row g-4">

        <% for(let dish of hotel.dishes){ %>





            <div class="col-xl-4 col-lg-6 col-md-6">

                <div class="dish-card">





                    <!-- IMAGE -->

                    <div class="dish-image-wrapper">

                        <img
                            src="<%= dish.image.url %>"
                            alt="<%= dish.name %>"
                            class="dish-image"
                        >

                    </div>





                    <!-- CONTENT -->

                    <div class="dish-content">





                        <!-- TOP -->

                        <div class="dish-top">

                            <h3 class="dish-name">

                                <%= dish.name %>

                            </h3>





                            <div class="dish-price">

                                ₹ <%= dish.price %>

                            </div>

                        </div>





                        <!-- DESCRIPTION -->

                        <p class="dish-description">

                            Delicious freshly prepared food with premium
                            quality ingredients and amazing taste.

                        </p>





                        <!-- BUTTONS -->

                        <div class="dish-actions">





                            <!-- ORDER -->

                            <form
                                action="/cart/buy-now"
                                method="POST"
                                class="w-100"
                            >

                                <input
                                    type="hidden"
                                    name="hotelId"
                                    value="<%= hotel._id %>"
                                >

                                <input
                                    type="hidden"
                                    name="dishId"
                                    value="<%= dish._id %>"
                                >

                                <button
                                    type="submit"
                                    class="order-btn w-100"
                                >

                                    Order Now

                                </button>

                            </form>





                            <!-- ADD TO CART -->

                            <form
                                action="/cart/add"
                                method="POST"
                                class="w-100"
                            >

                                <input
                                    type="hidden"
                                    name="hotelId"
                                    value="<%= hotel._id %>"
                                >

                                <input
                                    type="hidden"
                                    name="dishId"
                                    value="<%= dish._id %>"
                                >





                                <button
                                    type="submit"
                                    class="cart-btn w-100"
                                >

                                    Add To Cart

                                </button>

                            </form>

                        </div>

                    </div>

                </div>

            </div>

        <% } %>

    </div>

</div>





<!-- FOOTER -->

<%- include("partials/footer") %>





<!-- BOOTSTRAP -->

<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
></script>

</body>
</html>