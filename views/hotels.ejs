<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Restaurants | BhookhBite</title>

  <!-- Bootstrap -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/style.css">


  <!-- FONT AWESOME........... -->
  <link
     rel="stylesheet"
     href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
  />

</head>

<body class="bg-light">

  <!-- Navbar -->
  <%- include("partials/nav") %>



  <div class="container py-5">


    <!-- TOP SECTION -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-4 mb-5">


      <!-- LEFT SIDE -->
      <div>

        <h1 class="fw-bold display-5 mb-2">
          <i class="fa-solid fa-utensils text-warning me-3"></i>
          Explore Restaurants
        </h1>

        <p class="text-muted fs-5 mb-0">

          Discover top restaurants near you

        </p>

      </div>

    </div>



    <!-- HOTEL LIST -->
    <div class="row g-4">

      <% for(let hotel of hotels) { %>

        <div class="col-12">

          <!-- WHOLE CARD CLICKABLE -->
          <a
            href="/restaurants/<%= hotel._id %>"
            class="text-decoration-none text-dark"
          >

            <div class="card border-0 shadow-lg rounded-4 overflow-hidden hotel-card">


              <div class="row g-0 align-items-stretch h-100">


                <!-- LEFT IMAGE -->
                <div class="col-lg-4">

                  <img
                    src="<%= hotel.image.url %>"
                    alt="<%= hotel.name %>"
                    class="img-fluid w-100 h-100"
                    style="object-fit: cover; min-height: 280px;"
                  >

                </div>



                <!-- RIGHT DETAILS -->
                <div class="col-lg-8">

                  <div class="card-body p-4 d-flex flex-column h-100">


                    <!-- HOTEL NAME -->
                    <h2 class="fw-bold mb-4">

                      <%= hotel.name %>

                    </h2>



                    <!-- DETAILS -->
                    <div class="mb-4">

                      <p class="fs-5 mb-3 d-flex align-items-center">
                        <i class="fa-solid fa-location-dot text-danger me-3"></i>
                        <span><%= hotel.location %></span>
                      </p>

                      <p class="fs-5 mb-3 d-flex align-items-center">
                        <i class="fa-solid fa-star text-warning me-3"></i>
                        <span><%= hotel.rating %></span>
                      </p>

                      <p class="text-muted fs-5">

                        Serving delicious food with fast delivery
                        and premium quality ingredients.

                      </p>

                    </div>



                    <!-- SMALL TAG -->
                    <div class="mt-auto">

                      <span class="badge bg-dark px-3 py-2 fs-6">

                        View Restaurant →

                      </span>

                    </div>

                  </div>

                </div>

              </div>

            </div>

          </a>

        </div>

      <% } %>

    </div>

  </div>



  <!-- Footer -->
  <%- include("partials/footer") %>



  <!-- Bootstrap JS -->
  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
  ></script>

</body>

</html>