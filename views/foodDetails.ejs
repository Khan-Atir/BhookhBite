<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>

        <%= filteredData[0].dishName %> | BhookhBite

    </title>

    <!-- Bootstrap -->

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <!-- Google Font -->

    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet"
    >

    <!-- GLOBAL CSS -->

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

    <!-- PAGE CSS -->

    <link
        rel="stylesheet"
        href="/css/foodDetails.css"
    >

</head>

<body>



    <!-- NAVBAR -->

    <%- include("partials/nav") %>





    <div class="food-page">

        <div class="container py-5">



            <!-- PAGE HEADER -->

            <div class="page-top">

                <div>

                    <h1 class="page-title">

                        <%= filteredData[0].dishName %>

                    </h1>

                    <p class="page-subtitle">

                        Available from premium restaurants near you.

                    </p>

                </div>



                <div class="dish-count">

                    <%= filteredData.length %> Restaurants

                </div>

            </div>





            <!-- FOOD CARDS -->

            <div class="food-list">



                <% for(let data of filteredData){ %>





                    <div class="food-horizontal-card">



                        <!-- LEFT IMAGE -->

                        <div class="food-image-wrapper">

                            <img
                                src="<%= data.image.url %>"
                                alt="<%= data.dishName %>"
                                class="food-image"
                            >

                        </div>





                        <!-- RIGHT CONTENT -->

                        <div class="food-content">



                            <!-- TOP -->

                            <div class="food-top">



                                <div>

                                    <div class="restaurant-tag">

                                        <%= data.hotelName %>

                                    </div>



                                    <h2 class="food-name">

                                        <%= data.dishName %>

                                    </h2>



                                    <p class="food-location">

                                        📍 <%= data.location %>

                                    </p>

                                </div>





                                <div class="food-price">

                                    ₹ <%= data.price %>

                                </div>

                            </div>





                            <!-- RATING -->

                            <div class="rating-box">

                                ⭐ <%= data.rating %>

                            </div>





                            <!-- DESCRIPTION -->

                            <p class="food-description">

                                Freshly prepared delicious food made
                                with premium ingredients and delivered
                                hot & fresh to your doorstep.

                            </p>





                            <!-- BUTTONS -->

                            <div class="food-actions">



                                <form action="/cart/buy-now" method="POST">

                                  <input
                                    type="hidden"
                                    name="hotelId"
                                    value="<%= data.hotelId %>"
                                  >

                                   <input
                                    type="hidden"
                                    name="dishId"
                                    value="<%= data.dishId %>"
                                    >

                                  <button
                                    type="submit"
                                    class="order-btn"
                                  >

                                    Order Now

                                  </button>

                                </form>





                                <form action="/cart/add" method="POST">

                                    <input
                                        type="hidden"
                                        name="hotelId"
                                        value="<%= data.hotelId %>"
                                    >

                                    <input
                                        type="hidden"
                                        name="dishId"
                                        value="<%= data.dishId %>"
                                    >



                                    <button
                                        type="submit"
                                        class="cart-btn"
                                    >

                                        Add To Cart

                                    </button>

                                </form>

                            </div>

                        </div>

                    </div>





                <% } %>

            </div>

        </div>

    </div>





    <!-- FOOTER -->

    <%- include("partials/footer") %>

</body>

</html>