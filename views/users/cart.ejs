<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>

        Your Cart

    </title>





    <!-- BOOTSTRAP -->

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >





    <!-- CSS -->

    <link
        rel="stylesheet"
        href="/css/cart.css"
    >

</head>

<body>





    <!-- NAVBAR -->

    <%- include("../partials/nav.ejs") %>





    <div class="container py-5">





        <!-- TITLE -->

        <div class="cart-heading">

            <h1>

                Your Cart

            </h1>

            <div class="heading-line"></div>

        </div>





        <% if(!cart || cart.items.length === 0){ %>





            <!-- EMPTY CART -->

            <div class="empty-cart">

                <h2>

                    Your Cart Is Empty

                </h2>

                <a
                    href="/dishes"
                    class="browse-btn"
                >

                    Browse Foods

                </a>

            </div>





        <% } else { %>





        <div class="row g-4">





            <!-- LEFT SIDE -->

            <div class="col-lg-8">





                <div class="cart-items-wrapper">





                    <!-- TABLE HEADER -->

                    <div class="cart-table-header">

                        <p>

                            Item

                        </p>

                        <p>

                            Price

                        </p>

                        <p>

                            Quantity

                        </p>

                        <p>

                            Total

                        </p>

                    </div>





                    <!-- CART ITEMS -->

                    <% cart.items.forEach((item)=>{ %>





                    <div class="cart-item-card">





                        <!-- LEFT -->

                        <div class="item-left">

                            
                            <img
                                src="<%= item.image.url %>"
                                alt="<%= item.name %>"
                                class="cart-image"
                            >





                            <div class="item-info">

                                <h3>

                                    <%= item.name %>

                                </h3>





                                <p class="item-desc">

                                    Fresh & Delicious Food

                                </p>





                                <span class="veg-badge">

                                    ● Veg

                                </span>



                                <form
                                    action="/cart/<%= item.dishId %>/remove"
                                    method="POST"
                                >

                                    <button
                                        type="submit"
                                        class="remove-btn"
                                    >

                                        Remove

                                    </button>

                                </form>

                            </div>

                        </div>





                        <!-- PRICE -->

                        <div class="item-price">

                            ₹ <%= item.price %>

                        </div>





                        <!-- QUANTITY -->


<div class="quantity-box">

    <!-- DECREASE -->

    <form
        action="/cart/<%= item.dishId %>/decrease"
        method="POST"
    >
        <button
            type="submit"
            class="qty-btn"
        >
            -
        </button>
    </form>



    <span class="qty-number">

        <%= item.quantity %>

    </span>



    <!-- INCREASE -->

    <form
        action="/cart/<%= item.dishId %>/increase"
        method="POST"
    >
        <button
            type="submit"
            class="qty-btn"
        >
            +
        </button>
    </form>

</div>





                        <!-- TOTAL -->

                        <div class="item-total">

                            ₹ <%= item.price * item.quantity %>

                        </div>

                    </div>





                    <% }) %>





                    <!-- SAFE PAYMENT -->

                    <div class="safe-payment">

                        🛡️ Safe and secure payments.
                        100% satisfaction guaranteed.

                    </div>

                </div>





                <!-- COUPON -->

                <div class="coupon-box">

                    <div class="coupon-left">

                        🏷️ Apply Coupon

                    </div>





                    <input
                        type="text"
                        placeholder="Enter coupon code"
                    >





                    <button>

                        Apply

                    </button>

                </div>

            </div>





            <!-- RIGHT SIDE -->

            <div class="col-lg-4">





                <div class="bill-card">

                    <h2>

                        Bill Details

                    </h2>





                    <div class="bill-row">

                        <span>

                            Subtotal

                        </span>

                        <span>

                            ₹ <%= subtotal %>

                        </span>

                    </div>





                    <div class="bill-row">

                        <span>

                            Delivery Fee

                        </span>

                        <span>

                            ₹ <%= deliveryFee %>

                        </span>

                    </div>





                    <div class="bill-row">

                        <span>

                            Taxes

                        </span>

                        <span>

                            ₹ <%= taxes %>

                        </span>

                    </div>





                    <hr>





                    <div class="bill-total">

                        <span>

                            Total

                        </span>

                        <span class="green-total">

                            ₹ <%= total %>

                        </span>

                    </div>





                    <!-- CHECKOUT -->

                    <a
                        href="/orders/checkout"
                        class="checkout-btn"
                    >

                        🔒 Proceed To Checkout

                    </a>





                    <p class="secure-text">

                        🛡️ Secure checkout.
                        Easy returns.

                    </p>

                </div>

            </div>

        </div>

        <% } %>

    </div>

</body>

</html>