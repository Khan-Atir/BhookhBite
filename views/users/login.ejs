<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Login</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

</head>

<body class="bg-light">

    <%- include("../partials/nav.ejs") %>

    <div class="container py-5">

        <div class="row justify-content-center">

            <div class="col-lg-5">

                <div class="card shadow border-0 rounded-4 p-4">

                    <h1 class="text-center mb-4">

                        Login

                    </h1>

                    <form
                        action="/login"
                        method="POST"
                        class="needs-validation" novalidate
                    >

                        <!-- Username -->

                        <div class="mb-3">

                            <label class="form-label">
                                Username
                            </label>

                            <input
                                type="text"
                                name="username"
                                class="form-control"
                                required
                            >

                        </div>

                        <!-- Password -->

                        <div class="mb-4">

                            <label class="form-label">
                                Password
                            </label>

                            <input
                                type="password"
                                name="password"
                                class="form-control"
                                required
                            >

                        </div>

                        <button class="btn btn-dark w-100">

                            Login

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

    <script src="/js/script.js"></script>
</body>

</html>