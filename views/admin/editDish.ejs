<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>

        Edit Dish

    </title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

</head>

<body>

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-6">

            <div class="card shadow">

                <div class="card-body p-4">

                    <h2
                        class="fw-bold text-center mb-4"
                    >

                        Edit Dish

                    </h2>

                    <form

                        action="/admin/dishes/<%= dish._id %>?_method=PUT"

                        method="POST"

                        enctype="multipart/form-data"

                    >

                        <div class="mb-3">

                            <label
                                class="form-label"
                            >

                                Dish Name

                            </label>

                            <input

                                type="text"

                                name="name"

                                value="<%= dish.name %>"

                                class="form-control"

                                required
                            >

                        </div>

                        <div class="mb-4">

                            <label
                                class="form-label"
                            >

                                Image URL

                            </label>

                            <input

                                type="file"

                                name="image"

                                value="<%= dish.image.url %>"

                                class="form-control"

                            >

                        </div>

                        <button

                            class="btn btn-warning w-100"

                        >

                            Update Dish

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

</body>

</html>