<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>

        Manage Dishes

    </title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

</head>

<body>

<div class="container py-5">

    <!-- HEADER -->

    <div
        class="d-flex justify-content-between align-items-center mb-5"
    >

        <h1 class="fw-bold">

            Manage Dishes

        </h1>

        <a

            href="/admin/dishes/new"

            class="btn btn-dark btn-lg"

        >

            + Add New Dish

        </a>

    </div>





    <!-- DISHES -->

    <div class="row g-4">

        <% dishes.forEach((dish)=>{ %>

        <div class="col-md-4 col-lg-3">

            <div class="card h-100 shadow-sm">

                <img

                    src="<%= dish.image.url %>"

                    class="card-img-top"

                    style="height:220px; object-fit:cover;"

                >

                <div class="card-body">

                    <h5 class="card-title fw-bold">

                        <%= dish.name %>

                    </h5>

                </div>





                <div
                    class="card-footer bg-white border-0 d-flex gap-2"
                >

                    <a

                        href="/admin/dishes/<%= dish._id %>/edit"

                        class="btn btn-warning w-100"

                    >

                        Edit

                    </a>





                    <form

                        action="/admin/dishes/<%= dish._id %>?_method=DELETE"

                        method="POST"

                        class="w-100"

                    >

                        <button

                            type="submit"

                            class="btn btn-danger w-100"

                        >

                            Delete

                        </button>

                    </form>

                </div>

            </div>

        </div>

        <% }) %>

    </div>

</div>

</body>

</html>