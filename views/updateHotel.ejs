<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Update Restaurant | BhookhBite</title>

  <!-- Bootstrap -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/style.css">

</head>

<body class="bg-light">

  <!-- Navbar -->
  <%- include("partials/nav") %>



  <div class="container py-5">

    <div class="row justify-content-center">

      <div class="col-lg-8">


        <!-- CARD -->
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

          <div class="card-body p-5">


            <!-- Heading -->
            <div class="text-center mb-5">

              <h1 class="fw-bold">

                ✏️ Update Restaurant

              </h1>

              <p class="text-muted">

                Edit restaurant details

              </p>

            </div>



            <!-- FORM -->
            <form
              action="/partner/restaurants/<%= hotel._id %>?_method=PUT"
              method="POST"
              class="needs-validation" 
              novalidate
              enctype="multipart/form-data"
            >


              <!-- Restaurant Name -->
              <div class="mb-4">

                <label class="form-label fw-semibold">

                  Restaurant Name

                </label>

                <input
                  type="text"
                  name="name"
                  class="form-control form-control-lg"
                  value="<%= hotel.name %>"
                  required
                >
                <div class="invalid-feedback">
                  Please Enter your restaurant name.
                </div>
              </div>



              <!-- Location -->
              <div class="mb-4">

                <label class="form-label fw-semibold">

                  Location

                </label>

                <input
                  type="text"
                  name="location"
                  class="form-control form-control-lg"
                  value="<%= hotel.location %>"
                  required
                >
                <div class="invalid-feedback">
                  Please enter restaurant location.
                </div>
              </div>



              <!-- Restaurant Image -->
              <div class="mb-4">

                <label class="form-label fw-semibold">

                  Restaurant Image URL

                </label>

                <input
                  type="file"
                  name="image"
                  class="form-control form-control-lg"
                  value="<%= hotel.image %>"
                 
                >
                <div class="invalid-feedback">
                  Please upload restaurant image.
                </div>
              </div>



              <!-- Rating -->
              <div class="mb-5">

                <label class="form-label fw-semibold">

                  Rating

                </label>

                <input
                  type="number"
                  step="0.1"
                  min="1"
                  max="5"
                  name="rating"
                  class="form-control form-control-lg"
                  value="<%= hotel.rating %>"
                  required
                >

              </div>



              <!-- BUTTONS -->
              <div class="d-flex gap-3">


                <!-- Update -->
                <button
                  class="btn btn-warning btn-lg w-100"
                >

                  Update Restaurant

                </button>



                <!-- Cancel -->
                <a
                  href="/restaurants/<%= hotel._id %>"
                  class="btn btn-dark btn-lg w-100"
                >

                  Cancel

                </a>

              </div>

            </form>

          </div>

        </div>

      </div>

    </div>

  </div>



  <!-- Footer -->
  <%- include("partials/footer") %>



  <!-- Bootstrap -->
  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
  ></script>

  <script src="/js/script.js"></script>
</body>

</html>